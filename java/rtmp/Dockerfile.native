# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS go-builder
WORKDIR /build/go-hls
COPY go-hls/go.mod go-hls/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY go-hls/ ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/hls-segmenter .

FROM ghcr.io/graalvm/native-image-community:21-ol9 AS native-builder
RUN microdnf install -y findutils && microdnf clean all
WORKDIR /build
COPY build.gradle settings.gradle gradle.properties gradlew ./
COPY gradle gradle
COPY src src
COPY --from=frontend /dist frontend/dist
RUN --mount=type=cache,target=/root/.gradle \
    sed -i 's/\r$//' gradlew && chmod +x gradlew && \
    ./gradlew nativeCompile -PskipFrontendBuild --no-daemon

FROM debian:bookworm-slim
RUN mkdir -p /app/hls
WORKDIR /app
COPY --from=native-builder /build/build/native/nativeCompile/rtmp /app/rtmp
COPY --from=go-builder /out/hls-segmenter /usr/local/bin/hls-segmenter
COPY --from=frontend /dist /app/static
ENV RTMP_STATIC_DIR=file:/app/static
RUN chmod +x /app/rtmp /usr/local/bin/hls-segmenter
EXPOSE 8888 1935
ENTRYPOINT ["/app/rtmp"]